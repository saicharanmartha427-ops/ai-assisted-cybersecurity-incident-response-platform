{
  "openapi": "3.0.3",
  "info": {
    "title": "AI-Assisted Cybersecurity Incident Response Platform API",
    "version": "2.0.0",
    "description": "REST API for security event ingestion, anomaly detection, incident response, playbooks and reporting."
  },
  "servers": [
    {
      "url": "http://localhost:5000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT token"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Dashboard analytics",
        "responses": {
          "200": {
            "description": "Dashboard metrics"
          }
        }
      }
    },
    "/api/events": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a manual security event",
        "responses": {
          "201": {
            "description": "Event accepted"
          }
        }
      },
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List recent events",
        "responses": {
          "200": {
            "description": "Events"
          }
        }
      }
    },
    "/api/analyze": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Analyze CSV telemetry",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "sensitivity": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Analysis results"
          }
        }
      }
    },
    "/api/incidents": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List incidents",
        "responses": {
          "200": {
            "description": "Incidents"
          }
        }
      }
    },
    "/api/incidents/{id}": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get incident details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Incident details"
          }
        }
      },
      "patch": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Update incident",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated incident"
          }
        }
      }
    },
    "/api/incidents/{id}/actions": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Execute response action",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response executed"
          }
        }
      }
    },
    "/api/playbooks": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List playbooks",
        "responses": {
          "200": {
            "description": "Playbooks"
          }
        }
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create playbook (Admin)",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/reports": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List reports",
        "responses": {
          "200": {
            "description": "Reports"
          }
        }
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Generate report",
        "responses": {
          "201": {
            "description": "Report generated"
          }
        }
      }
    },
    "/api/reports/export.csv": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Export incidents CSV",
        "responses": {
          "200": {
            "description": "CSV file"
          }
        }
      }
    },
    "/api/reports/export.pdf": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Export incidents PDF",
        "responses": {
          "200": {
            "description": "PDF file"
          }
        }
      }
    },
    "/api/ai/status": {
      "get": {
        "summary": "Get Generative AI provider configuration status",
        "description": "Reports whether an LLM API key is configured without returning secrets. Deterministic detection remains active regardless of LLM availability.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Provider status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string"
                    },
                    "configured": {
                      "type": "boolean"
                    },
                    "model": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    }
  }
}
